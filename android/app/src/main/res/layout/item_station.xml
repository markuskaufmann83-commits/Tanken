<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/surface_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Brand Logo Tile -->
        <ImageView
            android:id="@+id/ivBrandLogo"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:src="@drawable/logo_brand_aral"
            android:scaleType="fitCenter"
            android:layout_marginEnd="12dp"
            android:contentDescription="Markenlogo" />

        <!-- Center info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Station Name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aral Tankstelle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Address -->
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hauptstraße 42, 10115 Berlin"
                android:textSize="11sp"
                android:textColor="@color/on_surface_muted"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <!-- Meta row: Distance + Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1,2 km"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_muted"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Geöffnet"
                    android:textSize="11sp"
                    android:textColor="@color/emerald" />
            </LinearLayout>

        </LinearLayout>

        <!-- Right info: Price & Route button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,68⁹ €"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/emerald" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoute"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Route"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/surface_border"
                android:textColor="@color/on_surface"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
